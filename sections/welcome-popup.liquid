<div class="welcome-popup" data-welcome-popup>
  <div class="welcome-popup__overlay" data-welcome-popup-overlay></div>
  <div class="welcome-popup__modal" role="dialog" aria-modal="true" aria-labelledby="WelcomePopupTitle">
    <button class="welcome-popup__close" type="button" aria-label="Close" data-welcome-popup-close>
      &times;
    </button>
    <h2 class="welcome-popup__title" id="WelcomePopupTitle">{{ section.settings.title }}</h2>
    <p class="welcome-popup__text">{{ section.settings.text }}</p>
    {%- if section.settings.button_label != blank -%}
      <a class="welcome-popup__button button" href="{{ section.settings.button_link | default: '/' }}">
        {{ section.settings.button_label }}
      </a>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Welcome Popup",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Willkommen!"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Test Popup - erscheint alle 5 Sekunden."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Jetzt shoppen"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link",
      "default": "/"
    }
  ],
  "presets": [
    {
      "name": "Welcome Popup"
    }
  ]
}
{% endschema %}
