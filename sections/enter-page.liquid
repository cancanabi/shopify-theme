{% if section.settings.show_enter_page %}
  <style>
    /* =========================================================
      ✅ ENTER PAGE – SAFE THEME HIDE (NO "NICHTS SICHTBAR" BUG)
    ========================================================== */
    header,
    .footer,
    .section-header,
    .section-footer { display: none !important; }

    .shopify-section { display: none !important; }

    #shopify-section-{{ section.id }} { display: block !important; }

    #MainContent,
    main#MainContent { display: block !important; }

    /* Theme Fonts NICHT kaputt machen */
    .wrapper,
    .wrapper * {
      font-family: inherit;
      letter-spacing: inherit;
    }

    /* =========================================================
      Animations
    ========================================================== */
    .scale-in-center {
      -webkit-animation: scale-in-center 1s cubic-bezier(.25,.46,.45,.94) both;
      animation: scale-in-center 1s cubic-bezier(.25,.46,.45,.94) both;
    }
    @-webkit-keyframes scale-in-center {
      0% { -webkit-transform: scale(0); transform: scale(0); opacity: 1; }
      100% { -webkit-transform: scale(1); transform: scale(1); opacity: 1; }
    }
    @keyframes scale-in-center {
      0% { -webkit-transform: scale(0); transform: scale(0); opacity: 1; }
      100% { -webkit-transform: scale(1); transform: scale(1); opacity: 1; }
    }

    .fade-in {
      -webkit-animation: fade-in 4s cubic-bezier(.39,.575,.565,1.000) both;
      animation: fade-in 4s cubic-bezier(.39,.575,.565,1.000) both;
    }
    @-webkit-keyframes fade-in { 0% { opacity: 0; } 100% { opacity: 1; } }
    @keyframes fade-in { 0% { opacity: 0; } 100% { opacity: 1; } }

    /* =========================================================
      Base layout
    ========================================================== */
    body, html {
      height: 100vh;
      width: 100vw;
      overflow: hidden;
      padding: 0 !important;
      margin: 0 !important;
    }

    .wrapper {
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;

      position: fixed;
      inset: 0;
      width: 100vw;
      height: 100vh;

      overflow: hidden;
      z-index: 999999 !important;

      background-repeat: no-repeat;
      background-size: cover;
      background-position: center center;

      {% if section.settings.enter_background_image %}
        background-image: url({{ section.settings.enter_background_image | img_url: 'master' }});
      {% endif %}
    }

    .wrapper { position: relative; }

    #enter-canvas{
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      z-index: 0;
      pointer-events: none;
      display: block;
    }

    .logo-container,
    .menu-container{
      position: relative;
      z-index: 6;
    }

    {% if section.settings.enter_background_image_mobile %}
    @media screen and (max-width: 500px){
      .wrapper{
        background-image: url({{ section.settings.enter_background_image_mobile | img_url: 'master' }});
      }
    }
    {% endif %}

    /* =========================================================
      Logo
    ========================================================== */
    .logo-container{
      margin-bottom: 30px;
      position: absolute;
      top: 2vh;
      display: flex;
      flex-direction: column;
      align-items: center;
    }
    @media screen and (max-width: 450px){
      .logo-container{ top: {{ section.settings.logo_container_top_mobile }}vh; }
    }

    .logo_enter{
      width: {{ section.settings.logoenter_size }}px;
      animation: logoFloatZoom 3.2s ease-in-out infinite;
      transform-origin: center;
      will-change: transform;
      display: block;
    }
    @media screen and (max-width: 450px){
      .logo_enter{ width: {{ section.settings.logoenter_size_mobile }}px; }
    }
    @keyframes logoFloatZoom{
      0%   { transform: translateY(0) scale(1); }
      50%  { transform: translateY(-6px) scale(1.06); }
      100% { transform: translateY(0) scale(1); }
    }

    /* =========================================================
      Menu Container
    ========================================================== */
    .menu-container{
      position: relative; /* ✅ FIX: safe anchor (ändert nichts am Layout) */
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      min-height: 100vh;
      z-index: 6;
      transform: translateY(70px);
    }
    @media screen and (max-width: 450px){
      .menu-container{ transform: translateY(90px); }
    }

    .enter-button{ text-align: center; }

    /* =========================================================
      ✅ LIQUID GLASS BOX (jetzt Container)
      -> Video füllt den kompletten Kasten, Text darüber
    ========================================================== */
    .menu-glass{
      position: relative;
      border-radius: 22px;
      overflow: hidden;
      isolation: isolate;

      width: fit-content;
      transform: translateY(-30px);

      min-height: {{ section.settings.menu_box_min_height }}px;

      background: rgba(6, 15, 35, 0.28);
      backdrop-filter: blur(16px) saturate(170%);
      -webkit-backdrop-filter: blur(16px) saturate(170%);

      border: 1px solid rgba(255,255,255,0.16);

      box-shadow:
        0 20px 70px rgba(0,0,0,0.45),
        0 0 40px rgba(56,189,248,0.22),
        0 0 120px rgba(99,102,241,0.14),
        inset 0 1px 0 rgba(255,255,255,0.20);
    }

    @media screen and (max-width: 450px){
      .menu-glass{
        max-width: 250px;
        width: fit-content;
        margin-left: auto;
        margin-right: auto;
      }
    }

    .menu-glass .menu-video-bg{
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      z-index: 1;
      pointer-events: none;
      overflow: hidden;
    }
    .menu-glass .menu-video-bg video{
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
      opacity: .95;
    }
    .menu-glass .menu-video-bg::after{
      content:"";
      position:absolute;
      inset:0;
      background: rgba(6,15,35,0.35);
      z-index: 2;
    }

    .menu-glass::before{
      content:"";
      position:absolute;
      inset:-2px;
      border-radius: inherit;
      background:
        radial-gradient(circle at 20% 15%, rgba(56,189,248,0.35), transparent 55%),
        radial-gradient(circle at 85% 85%, rgba(99,102,241,0.28), transparent 60%),
        radial-gradient(circle at 55% 45%, rgba(14,165,233,0.18), transparent 55%);
      filter: blur(14px);
      opacity: .9;
      z-index: 3;
      pointer-events: none;
    }

    .menu-glass::after{
      content:"";
      position:absolute;
      top:-40%;
      left:-60%;
      width: 42%;
      height: 180%;
      transform: rotate(18deg);
      background: linear-gradient(90deg, transparent, rgba(255,255,255,.18), transparent);
      animation: menuShimmer 2.8s ease-in-out infinite;
      opacity: .85;
      z-index: 4;
      pointer-events: none;
    }

    @keyframes menuShimmer{
      0%{ left:-60%; }
      100%{ left:140%; }
    }

    .menu-list{
      list-style: none;
      text-align: center;

      position: relative;
      padding: 22px 26px;
      margin: 0;

      background: transparent;
      z-index: 6;
    }

    .menu-item{
      margin-bottom: {{ section.settings.enter_menu_space }}px;
      text-align: {{ section.settings.menu_list_alignment }};
    }
    .menu-item:last-child{ margin-bottom: 0; }

    .menu-link{
      display: inline-flex;
      align-items: center;
      justify-content: center;

      font-size: {{ section.settings.menu_font_size }}px;
      font-weight: bold;
      color: {{ section.settings.menu_text_color }} !important;
      text-decoration: none !important;

      padding: 10px 18px;
      line-height: 1.2;
      text-transform: {{ section.settings.menu_text_transform }};

      border-radius: 14px;
      position: relative;
      outline: none;

      transition:
        transform .18s ease,
        background-color .18s ease,
        box-shadow .18s ease,
        filter .18s ease;
      -webkit-tap-highlight-color: transparent;

      {% if section.settings.show_text_glow %}
        -webkit-animation: pulse 1.5s ease-in-out infinite alternate;
        animation: pulse 1.5s ease-in-out infinite alternate;
        -webkit-backface-visibility: hidden;
      {% endif %}
    }

    .menu-link::before{
      content:"";
      position:absolute;
      inset: -6px -10px;
      border-radius: 18px;
      background:
        radial-gradient(circle at 30% 25%, rgba(56,189,248,.30), transparent 60%),
        radial-gradient(circle at 70% 75%, rgba(99,102,241,.22), transparent 60%);
      filter: blur(10px);
      opacity: 0;
      transition: opacity .18s ease;
      pointer-events: none;
      z-index: -1;
    }

    .menu-link:hover,
    .menu-link:focus-visible{
      background: rgba(255,255,255,.10);
      box-shadow:
        0 14px 44px rgba(0,0,0,.45),
        0 0 0 1px rgba(255,255,255,.10) inset,
        0 0 18px rgba(56,189,248,.25);
      transform: translateY(-1px);
    }
    .menu-link:hover::before,
    .menu-link:focus-visible::before{
      opacity: 1;
    }

    .menu-link:active{
      transform: translateY(0px) scale(.99);
      filter: brightness(1.02);
    }

    {% if section.settings.enable_menu_highlight %}
      .menu-list .menu-link:hover,
      .menu-list .menu-link:focus-visible{
        background: {{ section.settings.menu_highlight_color }} !important;
      }
    {% endif %}

    /* =========================================================
      Videos (Background Video – optional)
    ========================================================== */
    #bg-video_mobile{ display: none; }

    {% if section.settings.show_video_bg %}
      .wrapper{ background-color: transparent; }
      #bg-video{
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        overflow: hidden;
        z-index: -20;
      }
    {% endif %}

    {% if section.settings.background_video_url_mobile %}
    @media screen and (max-width: 500px){
      .wrapper{ background-color: transparent; }
      #bg-video{ display: none; }
      #bg-video_mobile{
        display: block;
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        overflow: hidden;
        z-index: -20;
      }
    }
    {% endif %}

    {% if section.settings.show_two_bg %}
      .wrapper{
        background-image: url({{ section.settings.two_bg_first | img_url: 'master' }});
        background-size: cover;
        background-repeat: no-repeat;
        background-position: center center;
      }
      #bg-video, #bg-video_mobile{ display: none; }

      .two_bg_enter_button a{
        display: inline-block;
        padding: 10px 14px;
        font-size: {{ section.settings.menu_font_size }}px;
        font-weight: bold;
        color: {{ section.settings.menu_text_color }} !important;
        text-decoration: none;
        text-transform: {{ section.settings.menu_text_transform }};
        cursor: pointer;
      }

      .enter-button{ display: none; }
    {% endif %}

    /* =========================================================
      Date/Time
    ========================================================== */
    #datetime{
      width: 100%;
      text-align: center;
      font-size: {{ section.settings.date_time_size }}px;
      margin: 0 !important;
      color: {{ section.settings.date_time_color }} !important;
    }

    /* =========================================================
      ✅ Socials – Blasen
    ========================================================== */
    .enterfooter{
      margin-top: 16px;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      width: 100%;
      position: relative;
      z-index: 9999999;
      pointer-events: auto;
      opacity: 1;
    }

    .enterfooter .footer__list-social.list-unstyled.list-social{
      position: static !important;
      transform: none !important;
      margin: 0 !important;
      padding: 0 !important;

      display: flex !important;
      justify-content: center !important;
      align-items: center !important;
      gap: 16px !important;
    }

    .enterfooter .list-social__item{
      display: flex !important;
      align-items: center !important;
      justify-content: center !important;
    }

    .enterfooter .list-social__link{
      display: inline-flex !important;
      align-items: center !important;
      justify-content: center !important;
      width: 44px !important;
      height: 44px !important;
      border-radius: 999px !important;

      background: rgba(0,0,0,.28) !important;
      border: 1px solid rgba(255,255,255,.14) !important;
      backdrop-filter: blur(10px) !important;
      -webkit-backdrop-filter: blur(10px) !important;

      transition: box-shadow .2s ease, background .2s ease;
      text-decoration: none !important;
      line-height: 0 !important;
    }

    .enterfooter .list-social__link:hover{
      background: rgba(0,0,0,.42) !important;
      box-shadow:
        0 14px 40px rgba(0,0,0,.45),
        0 0 18px rgba(56,189,248,.35);
    }

    .enterfooter svg{
      color: {{ section.settings.icons_color }} !important;
      fill: currentColor !important;
      stroke: currentColor !important;
      display: block !important;
    }
    .enterfooter svg *{
      fill: currentColor !important;
      stroke: currentColor !important;
    }

    .enterfooter .list-social__link svg{
      width: 24px !important;
      height: 24px !important;
      transform-origin: center;
      transition: transform .2s ease;
    }

    .enterfooter .list-social__link:hover svg{
      transform: scale(1.12);
    }

    .enterfooter a[href*="discord"] svg,
    .enterfooter a[href*="discord.gg"] svg{
      transform: scale(1.55);
      transform-origin: center;
    }
    .enterfooter a[href*="discord"]:hover svg,
    .enterfooter a[href*="discord.gg"]:hover svg{
      transform: scale(1.70);
    }

    {% unless section.settings.show_enterfooter %}
      .enterfooter{ display: none !important; }
    {% endunless %}

    /* =========================================================
      ✅ Payment Icons – FIX (NICHT MEHR IM LAYOUT, daher keine Verschiebung)
      -> sitzt kurz vor "Scroll down"
    ========================================================== */
    .enter-payments{
      position: fixed;
      left: 50%;
      bottom: 9vh;
      transform: translateX(-50%);

      display: inline-flex;
      justify-content: center;
      align-items: center;
      gap: 12px;

      flex-wrap: nowrap;
      white-space: nowrap;

      z-index: 99999998;
      pointer-events: auto;
    }
    @media screen and (max-width: 450px){
      .enter-payments{
        gap: 8px;
        bottom: 10vh;
      }

      .pay-bubble{
        width: 46px;
        height: 32px;
      }
    }

    .pay-bubble{
      width: 52px;
      height: 36px;
      border-radius: 14px;

      display: flex;
      justify-content: center;
      align-items: center;

      background: rgba(0,0,0,.28);
      border: 1px solid rgba(255,255,255,.14);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);

      box-shadow:
        0 14px 40px rgba(0,0,0,.45),
        inset 0 1px 0 rgba(255,255,255,.10);

      transition: transform .2s ease, box-shadow .2s ease;
    }

    .pay-bubble:hover{
      transform: translateY(-2px) scale(1.03);
      box-shadow:
        0 18px 60px rgba(0,0,0,.55),
        0 0 18px rgba(56,189,248,.25);
    }

    .pay-bubble img{
      max-width: 72%;
      max-height: 72%;
      object-fit: contain;
      display: block;
      filter: brightness(1.05);
    }

    /* =========================================================
      Copyright
    ========================================================== */
    .enter-copy{
      display:flex;
      margin-top: 10px;
      flex-direction:column;
      text-align:center;
    }

    small.copyright__content,
    small.copyright__content a{
      color: {{ section.settings.copy_text_color }} !important;
    }

    /* =========================================================
      Reveal transitions
    ========================================================== */
    :root{ --ease-premium: cubic-bezier(.22,.61,.36,1); }

    .logo-container,
    .menu-container{
      transition: transform 650ms var(--ease-premium), opacity 450ms ease, filter 650ms var(--ease-premium);
      will-change: transform, opacity, filter;
    }

    .wrapper.is-reveal .logo-container,
    .wrapper.is-reveal .menu-container{
      opacity: 0;
      transform: translateY(-18px) scale(.985);
      filter: blur(6px);
      pointer-events: none;
    }

    .wrapper.is-reveal .enterfooter{
      opacity: 0 !important;
      transform: translateY(18px) !important;
      pointer-events: none !important;
      visibility: hidden !important;
    }

    /* =========================================================
      Scroll panel + campaign (bleibt wie gehabt)
    ========================================================== */
    .enter-scroll-panel{
      position: absolute;
      inset: 0;
      z-index: 4;
      display: flex;
      align-items: center;
      justify-content: center;
      transform: translateY(110%);
      opacity: 0;
      transition: transform 800ms var(--ease-premium), opacity 450ms ease;
      pointer-events: none;
    }

    .enter-scroll-panel.is-open{
      transform: translateY(0);
      opacity: 1;
      pointer-events: auto;
    }

    .enter-scroll-inner{
      width: 100%;
      height: 100%;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 14px;
      padding: clamp(16px, 3vw, 52px);
    }

    .enter-campaign-stage{
      position: relative;
      width: min(980px, 92vw);
      height: min(78vh, 820px);
      display: grid;
      place-items: center;

      --bottle-w: {{ section.settings.bottle_w }}px;
      --tilt: {{ section.settings.bottle_tilt }}deg;
      --move: {{ section.settings.bottle_move }}px;
    }

    .enter-campaign-stage .enter-campaign-img{
      position: absolute;
      inset: 0;
      margin: auto;
      max-width: 100%;
      max-height: 100%;
      width: auto;
      height: auto;
      display: block;

      border-radius: 22px;
      box-shadow: 0 26px 90px rgba(0,0,0,.55);

      transition: transform 900ms var(--ease-premium), opacity 450ms ease, filter 650ms var(--ease-premium);
      will-change: transform, opacity, filter;
      cursor: pointer;
      z-index: 1;
    }

    .enter-campaign-img--1{ opacity: 1; transform: translateY(0) scale(1); filter: blur(0px); }

    .enter-campaign-img--2{
      opacity: 0;
      pointer-events: none;
      transform: translateY(12px) scale(.985);
      filter: blur(6px);
    }

    .enter-scroll-panel.step-2 .enter-campaign-img--1{
      opacity: 1;
      transform: translateX(-34vw) scale(.42);
      filter: blur(0px);
    }

    .enter-scroll-panel.step-2 .enter-campaign-img--2{
      opacity: 1;
      pointer-events: auto;
      transform: translateX(0) scale(1);
      filter: blur(0px);
    }

    @media (max-width: 500px){
      .enter-scroll-panel.step-2 .enter-campaign-img--1{ transform: translateX(-24vw) scale(.92); }
    }

    .enter-scroll-cta{
      font-size: 12px;
      letter-spacing: .14em;
      text-transform: uppercase;
      opacity: .78;
      user-select: none;
      text-align: center;
    }

    .enter-scroll-cta--pill{
      position: absolute;
      left: 50%;
      bottom: 20%;
      transform: translateX(-50%);
      z-index: 10000;
      pointer-events: auto;

      display: inline-flex;
      align-items: center;
      gap: 10px;

      padding: 12px 18px;
      border-radius: 999px;

      background: rgba(0,0,0,.50);
      border: 1px solid rgba(255,255,255,.18);
      backdrop-filter: blur(10px);

      font-size: 12px;
      letter-spacing: .14em;
      text-transform: uppercase;

      color: #fff;
      opacity: .98;

      box-shadow:
        0 18px 60px rgba(0,0,0,.45),
        0 0 0 1px rgba(255,255,255,.06) inset;

      animation: ctaFloat 1.8s var(--ease-premium) infinite;
      cursor: pointer;
      user-select: none;
      -webkit-tap-highlight-color: transparent;
      outline: none;
      overflow: hidden;
    }

    .enter-scroll-cta--pill .cta-arrow{
      display: inline-block;
      animation: ctaArrow 1.2s var(--ease-premium) infinite;
      opacity: .92;
      line-height: 1;
    }

    .enter-scroll-cta--pill:before{
      content:"";
      position:absolute;
      inset:-2px;
      border-radius: inherit;
      background:
        radial-gradient(circle at 30% 20%, rgba(56,189,248,.35), transparent 55%),
        radial-gradient(circle at 70% 80%, rgba(99,102,241,.25), transparent 60%);
      filter: blur(10px);
      opacity: .65;
      z-index:-1;
      pointer-events: none;
    }

    .enter-scroll-cta--pill:after{
      content:"";
      position:absolute;
      top:-40%;
      left:-60%;
      width: 40%;
      height: 180%;
      transform: rotate(18deg);
      background: linear-gradient(90deg, transparent, rgba(255,255,255,.22), transparent);
      animation: ctaShimmer 2.6s ease-in-out infinite;
      pointer-events: none;
    }

    @keyframes ctaFloat{
      0%,100%{ transform: translateX(-50%) translateY(0); }
      50%{ transform: translateX(-50%) translateY(8px); }
    }
    @keyframes ctaArrow{
      0%,100%{ transform: translateX(0); }
      50%{ transform: translateX(6px); }
    }
    @keyframes ctaShimmer{
      0%{ left:-60%; }
      100%{ left:140%; }
    }

    .enter-scroll-hint{
      position: absolute;
      left: 50%;
      bottom: 6%;
      transform: translateX(-50%);
      z-index: 6;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 6px;
      font-size: 12px;
      letter-spacing: .14em;
      text-transform: uppercase;
      opacity: .78;
      user-select: none;
      transition: opacity 280ms ease, transform 280ms ease;
      pointer-events: none;
    }

    .enter-scroll-hint .hint-arrow{
      font-size: 16px;
      line-height: 1;
      animation: hintBounce 1.6s var(--ease-premium) infinite;
      opacity: .9;
    }

    @keyframes hintBounce{
      0%,100%{ transform: translateY(0); }
      50%{ transform: translateY(6px); }
    }

    .wrapper.is-reveal .enter-scroll-hint{
      opacity: 0;
      transform: translateX(-50%) translateY(10px);
    }

    .enter-campaign-video{
      position: absolute;
      inset: 0;
      margin: auto;
      width: 100%;
      height: 100%;
      object-fit: cover;
      border-radius: 22px;
      box-shadow: 0 26px 90px rgba(0,0,0,.55);

      opacity: 0;
      pointer-events: none;
      transform: scale(.985);
      transition: opacity 700ms ease, transform 700ms ease;
      z-index: 3;
    }
    .enter-scroll-panel.step-3 .enter-campaign-video{
      opacity: 1;
      transform: scale(1);
      pointer-events: auto;
    }

    .bottle-hover-wrap{
      position: absolute;
      width: var(--bottle-w);
      transform: translate(-50%, -50%);
      transform-style: preserve-3d;
      perspective: 900px;
      z-index: 6;
      pointer-events: none;
      opacity: 0;
      transition: opacity 160ms ease;
      will-change: opacity, left, top, transform;
      left: {{ section.settings.bottle_x }}%;
      top: {{ section.settings.bottle_y }}%;
    }

    .enter-scroll-panel.is-open:not(.step-2):not(.step-3) .bottle-hover-wrap{ opacity: 1; }

    .bottle-hover-img{
      width: 100%;
      height: auto;
      display: block;
      transform-style: preserve-3d;
      will-change: transform;
      user-select: none;
      -webkit-user-drag: none;
      filter:
