  </script>

  <script>
    document.addEventListener('DOMContentLoaded', function () {
      var wrapper = document.querySelector('.wrapper');
      var panel   = document.getElementById('enter-scroll-panel');
      var img1    = document.getElementById('enter-campaign-img-1');
      var img2    = document.getElementById('enter-campaign-img-2');
      var cta     = document.querySelector('.enter-scroll-cta--pill');
      var video   = document.getElementById('campaign-video');

      if (!wrapper || !panel) return;
      if (!img1 || !img1.getAttribute('src')) return;

      var hasStep2 = !!img2;
      var hasStep3 = !!video;

      var step = 0;
      var lock = false;

      function applyStep(){
        panel.classList.toggle('is-open', step >= 1);
        wrapper.classList.toggle('is-reveal', step >= 1);

        panel.classList.toggle('step-2', step === 2);
        panel.classList.toggle('step-3', step === 3);

        panel.setAttribute('aria-hidden', step === 0 ? 'true' : 'false');

        if (video){
          if (step === 3){ video.play().catch(function(){}); }
          else {
            video.pause();
            try { video.currentTime = 0; } catch(e) {}
          }
        }
      }

      function nextStep(){
        if (lock) return;
        lock = true;

        if (step === 0) step = 1;
        else if (step === 1 && hasStep2) step = 2;
        else if (step === 2 && hasStep3) step = 3;

        applyStep();
        setTimeout(function(){ lock = false; }, 450);
      }

      function prevStep(){
        if (lock) return;
        lock = true;

        if (step === 3) step = 2;
        else if (step === 2) step = 1;
        else if (step === 1) step = 0;

        applyStep();
        setTimeout(function(){ lock = false; }, 450);
      }

      function enterShop(){ window.location.href = '/collections/all'; }

      window.addEventListener('wheel', function(e){
        if (Math.abs(e.deltaY) < 6) return;
        if (e.deltaY > 0) nextStep();
        else prevStep();
      }, { passive: true });

      var startY = null;
      window.addEventListener('touchstart', function(e){
        startY = e.touches && e.touches[0] ? e.touches[0].clientY : null;
      }, { passive: true });

      window.addEventListener('touchmove', function(e){
        if (startY == null) return;
        var y = e.touches[0].clientY;
        var dy = startY - y;
        if (dy > 18) nextStep();
        if (dy < -18) prevStep();
      }, { passive: true });

      window.addEventListener('touchend', function(){ startY = null; }, { passive: true });

      window.addEventListener('keydown', function(e){
        if (e.key === 'ArrowDown' || e.key === 'PageDown' || e.key === ' ') nextStep();
        if (e.key === 'ArrowUp' || e.key === 'PageUp' || e.key === 'Escape') prevStep();
      });

      img1.addEventListener('click', enterShop);
      if (img2) img2.addEventListener('click', enterShop);

      if (cta){
        cta.addEventListener('click', function(e){ e.preventDefault(); enterShop(); });
        cta.addEventListener('keydown', function(e){
          if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); enterShop(); }
        });
      }

      panel.addEventListener('click', function(e){
        if (e.target === panel) prevStep();
      });

      applyStep();
    });
  </script>

  <script>
    document.addEventListener('DOMContentLoaded', function () {
      var wrap = document.getElementById('bottle-hover-wrap');
      var img  = document.getElementById('bottle-hover-img');
      var stage = document.getElementById('enter-campaign-stage');
      if (!wrap || !img || !stage) return;

      function onMove(clientX, clientY){
        var rect = stage.getBoundingClientRect();
        var x = (clientX - rect.left) / rect.width;
        var y = (clientY - rect.top) / rect.height;
        x = Math.max(0, Math.min(1, x));
        y = Math.max(0, Math.min(1, y));

        var tilt = {{ section.settings.bottle_tilt | default: 14 }};
        var move = {{ section.settings.bottle_move | default: 18 }};

        var rx = (0.5 - y) * tilt;
        var ry = (x - 0.5) * tilt;
        var tx = (x - 0.5) * move;
        var ty = (y - 0.5) * move;

        img.style.transform = 'translate3d(' + tx + 'px,' + ty + 'px,0) rotateX(' + rx + 'deg) rotateY(' + ry + 'deg)';
      }

      window.addEventListener('mousemove', function(e){
        onMove(e.clientX, e.clientY);
      }, { passive: true });

      window.addEventListener('touchmove', function(e){
        if (!e.touches || !e.touches[0]) return;
        onMove(e.touches[0].clientX, e.touches[0].clientY);
      }, { passive: true });
    });
  </script>

  <script>
    function updateTime() {
      var el = document.getElementById("datetime");
      if (!el) return;

      var today = new Date();
      var date = today.toLocaleDateString().replace(/\./g, '/');
      var hours = today.getHours();
      var suffix = hours >= 12 ? 'PM' : 'AM';
      hours = hours % 12 || 12;
      var minutes = today.getMinutes();
      var time = hours + ':' + (minutes < 10 ? '0' : '') + minutes + ' ' + suffix;

      el.innerHTML = date + ' ' + time;
    }
    updateTime();
    setInterval(updateTime, 1000);
  </script>

  <script>
    (function () {
      var canvas = document.getElementById('enter-canvas');
      if (!canvas) return;

      var ctx = canvas.getContext('2d', { alpha: true });
      var particles = [];

      function resize() {
        var dpr = Math.max(1, window.devicePixelRatio || 1);
        canvas.width = Math.floor(canvas.clientWidth * dpr);
        canvas.height = Math.floor(canvas.clientHeight * dpr);
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      }

      function createParticles() {
        particles = [];
        var w = canvas.clientWidth;
        var h = canvas.clientHeight;
        var count = Math.floor(Math.min(140, Math.max(70, w / 14)));
        for (var i = 0; i < count; i++) {
          particles.push({
            x: Math.random() * w,
            y: Math.random() * h,
            r: Math.random() * 2 + 1,
            vx: (Math.random() - 0.5) * 0.28,
            vy: (Math.random() - 0.5) * 0.28
          });
        }
      }

      function drawBackground() {
        var w = canvas.clientWidth;
        var h = canvas.clientHeight;
        var g = ctx.createLinearGradient(0, 0, 0, h);
        g.addColorStop(0, '#020617');
        g.addColorStop(0.55, '#031a46');
        g.addColorStop(1, '#020617');
        ctx.fillStyle = g;
        ctx.fillRect(0, 0, w, h);
      }

      function tick() {
        var w = canvas.clientWidth;
        var h = canvas.clientHeight;

        drawBackground();

        for (var i = 0; i < particles.length; i++) {
          var p = particles[i];
          p.x += p.vx;
          p.y += p.vy;

          if (p.x < -10) p.x = w + 10;
          if (p.x > w + 10) p.x = -10;
          if (p.y < -10) p.y = h + 10;
          if (p.y > h + 10) p.y = -10;

          ctx.beginPath();
          ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
          ctx.fillStyle = 'rgba(56,189,248,0.80)';
          ctx.fill();
        }

        requestAnimationFrame(tick);
      }

      function onResize() {
        resize();
        createParticles();
      }

      window.addEventListener('resize', onResize);

      resize();
      createParticles();
      tick();
    })();
  </script>

{% endif %}

